generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  TRANSPORTEUR
  COMMISSIONNAIRE
  ADMIN
}

enum TypeToken {
  VERIFICATION_EMAIL
  REINITIALISATION_MDP
  RENOUVELER_DISPONIBILITE
}

enum MotifSignalement {
  SPAM
  FAUSSE_IDENTITE
  COMPORTEMENT_ABUSIF
  ARNAQUE
  AUTRE
}

enum StatutSignalement {
  OUVERT
  TRAITE
  REJETE
}

enum TypeDocument {
  KBIS
  LICENCE_TRANSPORT
  VIGILANCE_URSSAF
  REGULARITE_FISCALE
  ASSURANCE
  REGISTRE_COMMISSIONNAIRE
}

enum StatutDocument {
  EN_ATTENTE
  VALIDE
  REFUSE
}

enum StatutAbonnement {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TypeVehicule {
  PORTEUR
  SEMI
  VL
  UTILITAIRE
  PLATEAU
  BENNE
  CITERNE
  FOURGON
}

enum Specificite {
  HAYON
  FRIGORIFIQUE
  BACHE
  PLATEAU
  ADR
  GRUE
  AMPLIROLL
  CAISSE_MOBILE
  SAVOYARDE
  MEGA
  DOUBLE_PLANCHER
  VEHICULE_ACCOMPAGNE
}

// ─── Utilisateurs ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  telephone String?
  role      Role
  // Badge "SIRET vérifié" : entreprise existante et active (API officielle) ou validation admin
  verifie   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerifieLe DateTime?
  cguAccepteesLe DateTime?
  // Version des CGU acceptée (voir VERSION_CGU dans src/lib/legal.ts) : une nouvelle version redemande l'acceptation
  cguVersion     String?
  // Compte suspendu par un administrateur : connexion et sessions refusées
  suspendu       Boolean   @default(false)
  alertesEmail   Boolean   @default(true)
  // RGPD : compte anonymisé (les messages échangés sont conservés pour l'interlocuteur)
  supprimeLe     DateTime?
  // Les sessions ouvertes avant cette date sont invalidées (changement / réinitialisation du mot de passe)
  motDePasseChangeLe DateTime?

  // Documents légaux — conformité : date jusqu'à laquelle TOUS les documents obligatoires du rôle sont validés
  // (null = non conforme). Recalculée à chaque validation, remplacement, suppression ou expiration.
  documentsConformesJusqua DateTime?
  // Autorise l'autre partie d'une conversation à télécharger mes documents validés
  partageDocuments         Boolean   @default(false)

  transporteurProfil    TransporteurProfil?
  commissionnaireProfil CommissionnaireProfil?
  abonnement            Abonnement?
  messagesEnvoyes       Message[]                 @relation("expediteur")
  participations        ConversationParticipant[]
  avisDonnes            Avis[]                    @relation("auteurAvis")
  tokens                TokenEmail[]
  signalementsEmis      Signalement[]             @relation("signalant")
  signalementsRecus     Signalement[]             @relation("signale")
  alertes               Alerte[]
  documents             Document[]

  @@index([documentsConformesJusqua])
}

// ─── Profils ──────────────────────────────────────────────────────────────────

model TransporteurProfil {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  siret         String
  raisonSociale String
  description   String?

  siretVerifieLe     DateTime?
  activiteOfficielle String?

  // Position ACTUELLE, au niveau de la commune (centre de la commune fourni par l'API officielle) :
  // jamais de coordonnées GPS exactes. latitude/longitude = centre de la commune.
  latitude  Float
  longitude Float
  positionVille       String?
  positionInsee       String?
  positionDepartement String? // code département : "57", "2A", "971"…
  positionRegion      String? // code région INSEE

  // Zone d'intervention : rayon autour de la position et/ou départements où le transporteur accepte d'aller
  rayonInterventionKm Int?
  zonesCirculation    String[] // codes départements acceptés
  // Destination souhaitée (facultative), ex. « retour vers Lyon »
  destinationVille       String?
  destinationInsee       String?
  destinationDepartement String?

  // « Disponible maintenant » : expire automatiquement (durée réglable) pour éviter les annonces périmées
  disponible          Boolean   @default(false)
  disponibleJusqua    DateTime?
  dureeDisponibiliteH Int       @default(24)
  rappelDispoEnvoyeLe DateTime?
  // Dernière mise à jour de la position ou de la disponibilité (fraîcheur affichée aux commissionnaires)
  derniereMAJ         DateTime  @default(now())

  vehicules Vehicule[]
  annonces  Annonce[]
  avis      Avis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([disponible])
  @@index([positionDepartement, disponible, derniereMAJ])
  @@index([positionRegion])
  @@index([disponibleJusqua])
}

model CommissionnaireProfil {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  siret         String
  raisonSociale String

  siretVerifieLe     DateTime?
  activiteOfficielle String?

  besoins Besoin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Véhicules ────────────────────────────────────────────────────────────────

model Vehicule {
  id             String             @id @default(cuid())
  transporteurId String
  transporteur   TransporteurProfil @relation(fields: [transporteurId], references: [id], onDelete: Cascade)

  type         TypeVehicule
  specificites Specificite[]

  // Dimensions en cm
  longueur Float?
  largeur  Float?
  hauteur  Float?

  // Charge utile en kg
  chargeUtile Float

  immatriculation String?
  actif           Boolean @default(true)

  annonces Annonce[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transporteurId])
  @@index([type])
  @@index([chargeUtile])
}

// ─── Annonces de disponibilité ─────────────────────────────────────────────────
// Le cœur du modèle "inversé" : un transporteur qui va se retrouver vide publie
// son trajet retour pour être trouvé — au lieu de rouler à vide.

model Annonce {
  id             String             @id @default(cuid())
  transporteurId String
  transporteur   TransporteurProfil @relation(fields: [transporteurId], references: [id], onDelete: Cascade)
  vehiculeId     String?
  vehicule       Vehicule?          @relation(fields: [vehiculeId], references: [id], onDelete: SetNull)

  villeDepart String
  latDepart   Float
  lngDepart   Float
  // Commune de départ (résolue côté serveur) et sa zone
  inseeDepart       String?
  departementDepart String?
  regionDepart      String?

  // Destination souhaitée — vide = toutes directions
  villeArrivee       String?
  inseeArrivee       String?
  departementArrivee String?

  dateDisponibilite    DateTime
  dateDisponibiliteFin DateTime?

  commentaire String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latDepart, lngDepart])
  @@index([dateDisponibilite])
  @@index([active, dateDisponibilite])
  @@index([departementDepart, active])
  @@index([regionDepart])
}

// ─── Avis ─────────────────────────────────────────────────────────────────────
// Un commissionnaire ayant échangé avec un transporteur peut le noter — la
// confiance est le nerf de la guerre sur une bourse de fret (à la Trans.eu).

model Avis {
  id             String             @id @default(cuid())
  auteurId       String
  auteur         User               @relation("auteurAvis", fields: [auteurId], references: [id], onDelete: Cascade)
  transporteurId String
  transporteur   TransporteurProfil @relation(fields: [transporteurId], references: [id], onDelete: Cascade)

  note        Int // 1 à 5
  commentaire String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auteurId, transporteurId])
  @@index([transporteurId])
}

// ─── Messagerie ───────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  // userIds triés et joints : garantit une seule conversation par paire d'utilisateurs,
  // même si deux requêtes concurrentes tentent de la créer
  cle       String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteurId   String
  expediteur     User         @relation("expediteur", fields: [expediteurId], references: [id])

  contenu String
  lu      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, expediteurId, lu])
  @@index([expediteurId])
}

// ─── Abonnement / Stripe ──────────────────────────────────────────────────────

model Abonnement {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  statut         StatutAbonnement @default(TRIALING)
  dateFinEssai   DateTime?
  dateFinPeriode DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Besoins de transport ──────────────────────────────────────────────────────
// Le sens inverse des annonces : un commissionnaire publie un fret à faire
// transporter, les transporteurs proches répondent.

model Besoin {
  id                String                @id @default(cuid())
  commissionnaireId String
  commissionnaire   CommissionnaireProfil @relation(fields: [commissionnaireId], references: [id], onDelete: Cascade)

  villeDepart  String
  latDepart    Float
  lngDepart    Float
  villeArrivee String

  dateEnlevement DateTime
  typeVehicule   TypeVehicule?
  poidsKg        Float?
  description    String?
  active         Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latDepart, lngDepart])
  @@index([active, dateEnlevement])
}

// ─── Alertes (recherche enregistrée d'un commissionnaire) ──────────────────────

model Alerte {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Alerte autour d'une ville (rayon) …
  villeDepart  String?
  latDepart    Float?
  lngDepart    Float?
  rayonKm      Int     @default(100)
  villeArrivee String?
  // … et/ou par départements ("préviens-moi quand un transporteur est disponible dans le 57 ou le 67")
  departements String[] @default([])

  actif           Boolean   @default(true)
  derniereNotifLe DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([actif])
}

// ─── Sécurité & modération ─────────────────────────────────────────────────────

// Jetons à usage unique envoyés par e-mail — seul le hachage SHA-256 est stocké
model TokenEmail {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TypeToken
  tokenHash String    @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Signalement {
  id          String            @id @default(cuid())
  signalantId String
  signalant   User              @relation("signalant", fields: [signalantId], references: [id], onDelete: Cascade)
  cibleId     String
  cible       User              @relation("signale", fields: [cibleId], references: [id], onDelete: Cascade)
  motif       MotifSignalement
  details     String?
  statut      StatutSignalement @default(OUVERT)
  createdAt   DateTime          @default(now())
  traiteLe    DateTime?

  @@index([statut, createdAt])
  @@index([cibleId])
}

// Piste d'audit : connexions, échecs, réinitialisations, actions admin.
// Pas de clé étrangère : les traces survivent à la suppression du compte.
model JournalSecurite {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  ip        String?
  details   String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

// ─── Documents légaux (transporteurs et commissionnaires) ─────────────────────
// Un seul document courant par type et par utilisateur (le remplacer repasse en attente de validation).
// Le contenu est stocké chiffré (AES-256-GCM) dans une table séparée pour ne jamais être chargé par accident.

model Document {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   TypeDocument
  statut StatutDocument @default(EN_ATTENTE)

  nomFichier String // nom nettoyé, affiché uniquement
  mime       String // déterminé par le contenu (octets magiques), jamais par l'extension
  taille     Int
  sha256     String

  dateEmission   DateTime?
  dateExpiration DateTime

  motifRefus     String?
  verifieParId   String?
  verifieLe      DateTime?
  rappelEnvoyeLe DateTime?

  contenu DocumentContenu?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([statut])
  @@index([dateExpiration])
}

model DocumentContenu {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  donnees    Bytes // version(1) | iv(12) | tag(16) | texte chiffré
}

// ─── Référentiel géographique ─────────────────────────────────────────────────
// Données officielles (API geo.api.gouv.fr), chargées par la migration — jamais par le seed.
// latitude/longitude d'un département : commune la plus proche du barycentre de ses communes (placement des bulles de la carte).

model Region {
  code         String        @id
  nom          String
  departements Departement[]
}

model Departement {
  code       String @id
  nom        String
  regionCode String
  region     Region @relation(fields: [regionCode], references: [code])
  latitude   Float
  longitude  Float

  @@index([regionCode])
}
