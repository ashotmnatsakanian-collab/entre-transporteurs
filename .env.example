# ── Base de données ──────────────────────────────────────────────────────────
# En local :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entre_transporteurs"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/entre_transporteurs"

# Sur Supabase (remplacer ci-dessous) :
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="" # obligatoire, 32+ caractères (le serveur refuse de démarrer en production avec un secret faible)

# ── Stripe (OPTIONNEL) ────────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, l'accès est libre pour tout le monde (aucun paiement).
# Décommentez ces lignes uniquement quand vous voulez faire payer les commissionnaires.
# Clés de TEST disponibles sur https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# ID du prix mensuel (69 €/mois, commissionnaires uniquement) — Stripe Dashboard > Produits
# STRIPE_PRICE_ID="price_..."
# Secret du webhook — obtenu via : stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET="whsec_..."
# OBLIGATOIRE avec Stripe : date à partir de laquelle l'accès commissionnaire devient payant.
# Avant cette date l'accès reste gratuit et un bandeau prévient les utilisateurs ; à cette date chacun
# reçoit 30 jours d'essai sans carte. Les CGU promettent un préavis d'au moins 30 jours : annoncez, puis fixez la date.
# FACTURATION_A_PARTIR_DU="2027-01-15"

# ── Mode démonstration (NE PAS ACTIVER en production réelle) ───────────────────
# Affiche des boutons de connexion en un clic avec les comptes du seed (npm run db:seed).
# Variable lue au BUILD : à définir avant `npm run build`.
# NEXT_PUBLIC_DEMO_MODE=true

# ── E-mails (Resend — https://resend.com) ──────────────────────────────────────
# Sans RESEND_API_KEY : en développement les e-mails s'affichent dans la console ;
# en production ils ne partent pas (et la vérification d'adresse n'est pas exigée).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Entre Transporteurs <no-reply@votre-domaine.fr>"

# ── Informations légales de l'éditeur (pages mentions légales / CGU) ────────────
# EDITEUR_NOM="..."
# EDITEUR_FORME="SAS au capital de ... €"
# EDITEUR_ADRESSE="..."
# EDITEUR_SIRET="..."
# EDITEUR_RCS="..."          # facultatif
# EDITEUR_TVA="..."          # facultatif : n° de TVA ou « TVA non applicable, art. 293 B du CGI »
# EDITEUR_TELEPHONE="..."    # facultatif
# EDITEUR_DIRECTEUR="..."
# EMAIL_CONTACT="contact@votre-domaine.fr"

# ── Réseau ─────────────────────────────────────────────────────────────────────
# Nombre de reverse proxies devant l'application (1 sur Render) : sert à lire la vraie IP client
# TRUST_PROXY_HOPS=1

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
