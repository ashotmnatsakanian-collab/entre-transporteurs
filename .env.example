# ── Base de données ──────────────────────────────────────────────────────────
# En local :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entre_transporteurs"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/entre_transporteurs"

# Sur Supabase (remplacer ci-dessous) :
# DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgmode=transaction"
# DIRECT_URL="postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi-en-production"

# ── Stripe (OPTIONNEL) ────────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, l'accès est libre pour tout le monde (aucun paiement).
# Décommentez ces lignes uniquement quand vous voulez faire payer les commissionnaires.
# Clés de TEST disponibles sur https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# ID du prix mensuel (69 €/mois, commissionnaires uniquement) — Stripe Dashboard > Produits
# STRIPE_PRICE_ID="price_..."
# Secret du webhook — obtenu via : stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Mode démonstration (NE PAS ACTIVER en production réelle) ───────────────────
# Affiche des boutons de connexion en un clic avec les comptes du seed (npm run db:seed).
# Variable lue au BUILD : à définir avant `npm run build`.
# NEXT_PUBLIC_DEMO_MODE=true

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
